# Base URL of the destiny-repository API, including the version prefix.
VITE_API_BASE=http://localhost:8000/v1

# Skips sign-in entirely. Only useful against an API running with ENV=local,
# which bypasses auth itself. Never set this in a deployed build.
VITE_AUTH_DISABLED=true

# Required unless VITE_AUTH_DISABLED=true. These match the local Keycloak from
# `docker compose --profile keycloak up`.
# VITE_KEYCLOAK_URL=http://localhost:8080
# VITE_KEYCLOAK_REALM=destiny
# VITE_KEYCLOAK_CLIENT_ID=destiny-auth-client-local
